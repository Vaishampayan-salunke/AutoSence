# AutoSense Environment Configuration Example
# Copy this file to .env and fill in your local secrets. NEVER commit .env to version control!

# Application Environment
AUTOSENSE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=autosense_research_super_secret_jwt_key_2026_change_in_production

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=autosense_db
MYSQL_USER=autosense_user
MYSQL_PASSWORD=autosense_password
DATABASE_URL=mysql+pymysql://autosense_user:autosense_password@localhost:3306/autosense_db

# Fallback SQLite DB for offline/local standalone mode
SQLITE_DATABASE_PATH=V:/BDT/bigdata/mysql/autosense_local.db

# Hadoop / Sqoop / Hive Environment
HADOOP_HOME=/usr/local/hadoop
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_RAW_REVIEWS_DIR=/autosense/raw/reviews
HDFS_RAW_ASPECTS_DIR=/autosense/raw/aspects
HIVE_DATABASE=autosense
HIVE_HOST=localhost
HIVE_PORT=10000

# Model Paths & Versioning
MODEL_REGISTRY_PATH=V:/BDT/models/model_registry/model_registry.json
ACTIVE_MODEL_VERSION=autosense-tfidf-lr-v1
